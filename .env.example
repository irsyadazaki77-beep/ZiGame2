# ==============================================================================
# ZiGame 2.0 - Environment Variable Template
# ==============================================================================
# SECURITY NOTICE:
# Public API keys stored in firebase-applet-config.json or VITE_FIREBASE_* env vars
# are exposed to the browser. Ensure HTTP Referrer Restrictions & API Key restrictions
# are enforced in the Google Cloud Console / Firebase Console for production deployments.
# ==============================================================================

# Core Server Configuration
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Admin Access Control (Comma-separated Firebase UIDs authorized for admin routes)
ADMIN_UIDS=""

# Firebase Admin SDK Credentials (Server-side)
# Provide either FIREBASE_SERVICE_ACCOUNT (JSON string) or GOOGLE_APPLICATION_CREDENTIALS (file path).
# If unconfigured in development, the server falls back to an in-memory persistence adapter.
FIREBASE_SERVICE_ACCOUNT=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Firebase Client SDK Configuration (Vite Client-side)
# Automatically populated by AI Studio or configured manually.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID="(default)"

# Feature Flags & Emergency Kill Switches ('true' to disable feature)
KILL_SWITCH_RANKED="false"
KILL_SWITCH_ECONOMY="false"
KILL_SWITCH_SEASONS="false"
