{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and game sync state.",
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number" },
        "revision": { "type": "number" },
        "updatedAt": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "profile": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 30 },
            "avatar": { "type": "string", "maxLength": 10 },
            "colorTheme": { "type": "string", "maxLength": 20 },
            "coins": { "type": "number" },
            "unlockedAvatars": { "type": "array" },
            "unlockedThemes": { "type": "array" }
          }
        },
        "games": { "type": "array" },
        "achievements": { "type": "array" },
        "missions": { "type": "array" },
        "recentlyPlayed": { "type": "array" }
      }
    },
    "UserEconomy": {
      "title": "UserEconomy",
      "description": "Server-authoritative coin balances.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "coins": { "type": "number" },
        "totalEarned": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastUpdated": { "type": "number" }
      }
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Global verified game leaderboard scores.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "playerName": { "type": "string" },
        "playerAvatar": { "type": "string" },
        "score": { "type": "number" },
        "submittedAt": { "type": "string" },
        "gameId": { "type": "string" },
        "masteryLevel": { "type": "number" },
        "tier": { "type": "string" },
        "rating": { "type": "number" }
      }
    },
    "CompetitiveProfile": {
      "title": "CompetitiveProfile",
      "description": "Server-authoritative competitive ratings and tiers.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "globalRating": { "type": "number" },
        "globalTier": { "type": "string" },
        "peakGlobalRating": { "type": "number" },
        "gameRatings": { "type": "object" },
        "seasonId": { "type": "string" },
        "rankedGames": { "type": "number" },
        "lastUpdated": { "type": "number" }
      }
    },
    "RankedSession": {
      "title": "RankedSession",
      "description": "Short-lived session for verified ranked play.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "gameId": { "type": "string" },
        "nonce": { "type": "string" },
        "startTime": { "type": "number" },
        "expiresAt": { "type": "number" },
        "isRanked": { "type": "boolean" },
        "status": { "type": "string" },
        "seasonId": { "type": "string" }
      }
    },
    "Season": {
      "title": "Season",
      "description": "Competitive season configuration.",
      "type": "object",
      "properties": {
        "seasonId": { "type": "string" },
        "name": { "type": "string" },
        "startAt": { "type": "number" },
        "endAt": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "UserSecurity": {
      "title": "UserSecurity",
      "description": "Server-authoritative anti-cheat strike counter and account suspension state.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "strikeCount": { "type": "number" },
        "isBanned": { "type": "boolean" },
        "banReason": { "type": "string" },
        "bannedAt": { "type": "number" },
        "banExpiresAt": { "type": "number" },
        "bannedBy": { "type": "string" },
        "lastViolationAt": { "type": "number" },
        "lastViolationReason": { "type": "string" }
      }
    },
    "SecurityEvent": {
      "title": "SecurityEvent",
      "description": "Server-authoritative security audit log for bans, HMAC signature tampering, and payload violations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "eventType": { "type": "string" },
        "severity": { "type": "string" },
        "reason": { "type": "string" },
        "endpoint": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profile and sync state."
    },
    "/userEconomy/{userId}": {
      "schema": { "$ref": "#/entities/UserEconomy" },
      "description": "Server-authoritative user balances."
    },
    "/competitiveProfiles/{userId}": {
      "schema": { "$ref": "#/entities/CompetitiveProfile" },
      "description": "Server-authoritative competitive ratings."
    },
    "/rankedSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/RankedSession" },
      "description": "Active game sessions."
    },
    "/leaderboards/{gameId}/entries/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Authoritative game leaderboards."
    },
    "/seasons/{seasonId}": {
      "schema": { "$ref": "#/entities/Season" },
      "description": "Competitive season metadata."
    },
    "/seasonalLeaderboards/{seasonId}/games/{gameId}/entries/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Historical seasonal leaderboards."
    },
    "/userSecurity/{userId}": {
      "schema": { "$ref": "#/entities/UserSecurity" },
      "description": "Server-authoritative user security and suspension records."
    },
    "/securityEvents/{eventId}": {
      "schema": { "$ref": "#/entities/SecurityEvent" },
      "description": "Server-authoritative security audit trail."
    }
  }
}
