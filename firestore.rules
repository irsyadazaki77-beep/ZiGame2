rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny-All Rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }

    function isValidUser(data) {
      return data.keys().hasAll(['profile'])
        && data.profile is map
        && data.profile.keys().hasAll(['name'])
        && data.profile.name is string
        && data.profile.name.size() >= 2
        && data.profile.name.size() <= 30;
    }

    // User Profile and Sync State
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && isValidUser(incoming())
        // Client cannot set initial coins > 100
        && (!('coins' in incoming().profile) || incoming().profile.coins <= 100)
        // Ensure no administrative / sensitive fields are set on create
        && !incoming().keys().hasAny(['isAdmin', 'isBanned', 'verifiedBalance', 'role']);

      allow update: if (
        isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && isValidUser(incoming())
        // Client cannot tamper with administrative / sensitive fields
        && (!incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'isBanned', 'verifiedBalance', 'role']))
        // IMMUTABLE FIELD: Coins must not change during client-direct updates (must use server /api endpoints)
        && (
          !('profile' in incoming()) || 
          !('coins' in incoming().profile) ||
          !('profile' in existing()) ||
          !('coins' in existing().profile) ||
          incoming().profile.coins == existing().profile.coins
        )
      );
      
      allow delete: if false;
    }

    // Server-Authoritative Economy Store (Read: Owner, Write: Server Admin Only)
    match /userEconomy/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow write: if false;
    }

    // User Inventory (Read: Owner, Write: Server Admin Only)
    match /userInventory/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow write: if false;

      match /items/{itemId} {
        allow read: if isSignedIn() && request.auth.uid == userId && isValidId(itemId);
        allow write: if false;
      }
    }

    // Spin Cooldowns (Read: Owner, Write: Server Admin Only)
    match /spinCooldowns/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow write: if false;
    }

    // Economy Transaction Ledger (Read: Owner, Write: Server Admin Only)
    match /economyTransactions/{txId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid && isValidId(txId);
      allow write: if false;
    }

    // Cloud Saves collection with schema version validation
    match /cloudSaves/{saveId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(saveId);
      allow create: if isSignedIn() 
        && isValidId(saveId)
        && incoming().userId == request.auth.uid
        && incoming().schemaVersion is number
        && incoming().schemaVersion >= 1;
      allow update: if isSignedIn() 
        && isValidId(saveId)
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().updatedAt >= existing().updatedAt;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid && isValidId(saveId);
    }

    // Leaderboards (Read: Authenticated Users, Write: Server Authoritative ONLY)
    match /leaderboards/{gameId} {
      allow read: if isSignedIn() && isValidId(gameId);
      
      match /entries/{entryId} {
        allow read: if isSignedIn() && isValidId(entryId);
        allow write: if false;
      }
    }

    // Seasonal Leaderboards (Read: Authenticated Users, Write: Server Authoritative ONLY)
    match /seasonalLeaderboards/{seasonId} {
      allow read: if isSignedIn() && isValidId(seasonId);
      
      match /games/{gameId}/entries/{userId} {
        allow read: if isSignedIn() && isValidId(gameId) && isValidId(userId);
        allow write: if false;
      }
    }

    // Competitive Profiles (Read: Owner, Write: Server Admin Only)
    match /competitiveProfiles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow write: if false;
    }

    // Season Metadata (Read: Authenticated Users, Write: Server Admin Only)
    match /seasons/{seasonId} {
      allow read: if isSignedIn() && isValidId(seasonId);
      allow write: if false;
    }

    // Ranked Sessions (Server Admin Only via Admin SDK)
    match /rankedSessions/{sessionId} {
      allow read, write: if false;
    }

    // Game Sessions for Anti-Cheat Nonce Validation (Server Admin Only via Admin SDK)
    match /gameSessions/{sessionId} {
      allow read, write: if false;
    }

    // Suspicious Score Audit Logs (Server Admin Only via Admin SDK)
    match /suspiciousScores/{scoreId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Rate Limits (Server Admin Only via Admin SDK)
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // Processed Actions for Idempotency (Server Admin Only via Admin SDK)
    match /processedActions/{actionKey} {
      allow read, write: if false;
    }
  }
}
