rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny-All Rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidUser(data) {
      return data.keys().hasAll(['profile'])
        && data.profile is map
        && data.profile.keys().hasAll(['name'])
        && data.profile.name is string
        && data.profile.name.size() >= 2
        && data.profile.name.size() <= 30;
    }

    // User Profile and Save Data
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && isValidUser(incoming())
        // Client cannot set initial coins > 100
        && (!('coins' in incoming().profile) || incoming().profile.coins <= 100)
        // Ensure no protected fields are set on create
        && !incoming().keys().hasAny(['isAdmin', 'isBanned', 'verifiedBalance']);

      allow update: if (
        isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && isValidUser(incoming())
        // Client cannot tamper with administrative fields
        && (!incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'isBanned', 'verifiedBalance']))
        // IMMUTABLE FIELD: Coins must not change during a client update
        && (
          !('profile' in incoming()) || 
          !('coins' in incoming().profile) ||
          !('profile' in existing()) ||
          !('coins' in existing().profile) ||
          incoming().profile.coins == existing().profile.coins
        )
      );
      
      allow delete: if false;
    }

    // Cloud Saves collection with schema version validation
    match /cloudSaves/{saveId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(saveId);
      allow create: if isSignedIn() 
        && isValidId(saveId)
        && incoming().userId == request.auth.uid
        && incoming().schemaVersion is number
        && incoming().schemaVersion >= 1;
      allow update: if isSignedIn() 
        && isValidId(saveId)
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().updatedAt >= existing().updatedAt;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid && isValidId(saveId);
    }

    // Global Public Leaderboards (Read: Any Authenticated User, Write: Server Authoritative ONLY)
    match /leaderboards/{gameId} {
      allow read: if true; // Public leaderboard view
      
      match /entries/{entryId} {
        allow read: if true;
        // Leaderboard writes are handled by the server admin SDK
        allow create, update, delete: if false;
      }
    }

    // Transactions Ledger (Immutable Write-Once, Read: Owner Only)
    match /transactions/{txId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid && isValidId(txId);
      // Transactions are handled by the server
      allow create, update, delete: if false; 
    }

    // Game Sessions for Anti-Cheat Nonce Validation
    match /gameSessions/{sessionId} {
      // Game sessions are managed by the server
      allow read, write: if false;
    }
  }
}
